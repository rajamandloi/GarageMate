# GarageMate Backend Environment
NODE_ENV=production
PORT=5000

# MongoDB
MONGODB_URI=your_mongodb_connection_string

# JWT - use a cryptographically random secret of at least 32 characters
JWT_SECRET=replace_with_a_long_random_secret
JWT_ISSUER=garagemate-api
JWT_AUDIENCE=garagemate-app

# CORS - comma-separated trusted web origins. Flutter native requests do not need this.
ALLOWED_ORIGINS=https://your-production-web-domain.example

# Only set TRUST_PROXY=true when the server is actually behind one trusted reverse proxy.
TRUST_PROXY=false

# Request limits
JSON_BODY_LIMIT=256kb
URLENCODED_BODY_LIMIT=64kb

# Email
EMAIL_USER=your_email
EMAIL_PASS=your_email_app_password

# Backend public URL (used by invoice/email features where applicable)
BACKEND_URL=https://your-backend.example

# Firebase Admin / FCM
# Keep the actual service-account JSON outside the repository.

# WhatsApp / Meta
WHATSAPP_VERIFY_TOKEN=replace_with_random_webhook_verify_token
WHATSAPP_APP_SECRET=your_meta_app_secret

# Optional AI integration
OPENAI_API_KEY=
OPENAI_MODEL=

# Registration verification
# Email verification uses EMAIL_USER/EMAIL_PASS through Nodemailer.
# Phone verification uses Firebase Phone Authentication in the Flutter app.
# No SMS provider secret is required by the backend for phone verification.
